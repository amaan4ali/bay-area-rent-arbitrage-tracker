{
  "expo": {
    "name": "FoodSplitter",
    "slug": "food-splitter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "foodsplitter",
    "userInterfaceStyle": "automatic",
    "owner": "YOUR_EXPO_USERNAME",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/YOUR_PROJECT_ID"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foodsplitter.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "FoodSplitter needs camera access to scan your receipts and automatically extract bill items.",
        "NSPhotoLibraryUsageDescription": "FoodSplitter needs photo library access to select receipt images for scanning.",
        "NSContactsUsageDescription": "FoodSplitter needs contacts access to easily find and add friends to split bills with.",
        "NSFaceIDUsageDescription": "FoodSplitter uses Face ID to securely authorize payments.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": ["applinks:foodsplitter.app"],
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.foodsplitter.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "READ_CONTACTS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#e94560",
          "sounds": ["./assets/notification-sound.wav"]
        }
      ],
      "@stripe/stripe-react-native",
      [
        "expo-contacts",
        {
          "contactsPermission": "FoodSplitter needs access to your contacts to find friends to split bills with."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FoodSplitter needs access to your photos to select receipt images.",
          "cameraPermission": "FoodSplitter needs access to your camera to scan receipts."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
