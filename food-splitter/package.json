{
  "name": "food-splitter",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "eslint . --ext .ts,.tsx",
    "icons": "node scripts/generate-icons.js",
    "setup": "bash scripts/setup-app-store.sh",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "deploy:functions": "cd functions && npm run build && firebase deploy --only functions",
    "ship": "bash scripts/build-and-submit.sh ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.0",
    "@react-navigation/native": "^7.0.0",
    "@stripe/stripe-react-native": "^0.38.0",
    "expo": "~52.0.0",
    "expo-camera": "~16.0.0",
    "expo-contacts": "~14.0.0",
    "expo-file-system": "~18.0.0",
    "expo-image-picker": "~16.0.0",
    "expo-notifications": "~0.29.0",
    "expo-router": "~4.0.0",
    "firebase": "^11.0.0",
    "react": "18.3.1",
    "react-native": "0.76.0",
    "react-native-paper": "^5.12.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/react": "~18.3.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "~5.6.0"
  }
}
