# === Database ===
DATABASE_URL=postgresql://user:password@localhost:5432/rent_tracker

# === AWS ===
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=rent-arbitrage-raw-data

# === Scraper ===
SCRAPE_RATE_LIMIT_SECONDS=2.0
SCRAPE_MAX_RETRIES=3
SCRAPE_TIMEOUT_SECONDS=15

# === PySpark ===
SPARK_MASTER=local[*]
SPARK_APP_NAME=rent-arbitrage-pipeline
SPARK_JDBC_DRIVER_PATH=/opt/spark/jars/postgresql-42.7.1.jar

# === Dashboard ===
DASH_HOST=0.0.0.0
DASH_PORT=8050
DASH_DEBUG=true
DASH_REFRESH_INTERVAL_HOURS=6

# === Scoring ===
ZSCORE_UNDERPRICED_THRESHOLD=-1.5
ROLLING_WINDOW_WEEKS=4
